[sub_resource type="GDScript" id="GDScript_t4edt"]
script/source = "extends CharacterBody2D\n\nconst GRID = preload(\"res://scripts/grid_config.gd\")\nconst MOVE_ACTIONS = [&\"ui_up\", &\"ui_down\", &\"ui_left\", &\"ui_right\"]\nconst MOVE_DIRECTIONS = [Vector2.UP, Vector2.DOWN, Vector2.LEFT, Vector2.RIGHT]\n\n@export var cell_size: int = GRID.TILE_SIZE\n@export var move_speed: float = 10.0\n\nvar target_position: Vector2\nvar held_actions: Array[StringName] = []\n\nfunc _ready():\n\ttarget_position = position\n\tif is_inside_tree():\n\t\tget_window().focus_exited.connect(_clear_held_movement)\n\nfunc _process(delta: float) -> void:\n\tvar dir = _read_direction_just_pressed()\n\tif dir != Vector2.ZERO:\n\t\t_start_move(dir)\n\tposition = position.lerp(target_position, move_speed * delta)\n\tif position.distance_to(target_position) < 1.0:\n\t\tposition = target_position\n\t\tvar held_dir = _read_held_direction()\n\t\tif held_dir != Vector2.ZERO:\n\t\t\t_start_move(held_dir)\n\nfunc _read_direction_just_pressed() -> Vector2:\n\tvar dir = Vector2.ZERO\n\tfor index in range(MOVE_ACTIONS.size()):\n\t\tvar action = MOVE_ACTIONS[index]\n\t\tif Input.is_action_just_pressed(action):\n\t\t\theld_actions.erase(action)\n\t\t\theld_actions.append(action)\n\t\t\tdir = MOVE_DIRECTIONS[index]\n\treturn dir\n\nfunc _read_held_direction() -> Vector2:\n\tfor index in range(held_actions.size() - 1, -1, -1):\n\t\tvar action = held_actions[index]\n\t\tif not Input.is_action_pressed(action):\n\t\t\theld_actions.remove_at(index)\n\t\t\tcontinue\n\t\treturn MOVE_DIRECTIONS[MOVE_ACTIONS.find(action)]\n\treturn Vector2.ZERO\n\nfunc _clear_held_movement() -> void:\n\theld_actions.clear()\n\nfunc _start_move(dir: Vector2) -> void:\n\tposition = target_position\n\ttarget_position += dir * cell_size\n"

